{
  "name": "auditor-recorridos",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.auditorrecorridos",
    "productName": "Auditor de Recorridos",
    "files": [
      "main.js",
      "public/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "forceCodeSigning": false
    }
  }
}
